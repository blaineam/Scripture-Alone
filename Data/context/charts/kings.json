      {"name": "David", "reign": "1010–970 BC", "years": "40", "verdict": "good", "ref": "2SA 5:4", "note": "A man after God's own heart; the Davidic covenant (2 Sam 7).", "prophets": ["Samuel", "Nathan", "Gad"]},
