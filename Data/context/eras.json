{
  "_about": "Authored for Scripture Alone. Years are integers; negative = BC (no year zero is ever displayed). Dates follow the conservative chronology of Merrill (Kingdom of Priests, 2nd ed. 2008) and Thiele (The Mysterious Numbers of the Hebrew Kings, 3rd ed. 1983) for the Old Testament, Hoehner (Chronological Aspects of the Life of Christ, 1977) and Bruce (Paul: Apostle of the Heart Set Free, 1977) for the New, cross-checked against Finegan (Handbook of Biblical Chronology, rev. ed. 1998). See docs/context-sources.md. `debate` flags a date scholars genuinely dispute.",
  "eras": [
    {
      "id": "primeval",
      "name": "Primeval History",
      "short": "Primeval",
      "start": null, "end": null,
      "dates": "Undated",
      "color": "#8A8F98",
      "summary": "Creation, the fall, the flood and Babel — the world before Abraham.",
      "debate": "Genesis 1–11 gives no chronology scholars agree on. Some read the genealogies of Genesis 5 and 11 as complete (Ussher dated creation to 4004 BC); many conservative scholars read them as selective."
    },
    {
      "id": "patriarchs",
      "name": "The Patriarchs",
      "short": "Patriarchs",
      "start": -2166, "end": -1446,
      "dates": "c. 2166–1446 BC",
      "color": "#B7813A",
      "summary": "Abraham, Isaac, Jacob and Joseph; the covenant promises; Israel grows into a nation in Egypt.",
      "debate": "Dates count back from the early exodus date using 1 Kings 6:1 (480 years) and Exodus 12:40 (430 years in Egypt). On the late exodus date the patriarchs fall some two centuries later."
    },
    {
      "id": "exodus",
      "name": "Exodus & Wilderness",
      "short": "Exodus",
      "start": -1446, "end": -1406,
      "dates": "c. 1446–1406 BC",
      "color": "#C7543C",
      "summary": "Deliverance from Egypt, the covenant and law at Sinai, the tabernacle, forty years in the wilderness.",
      "debate": "The early date (c. 1446 BC) follows 1 Kings 6:1 and Judges 11:26; many scholars prefer a late date (c. 1260 BC) under Ramesses II, citing Exodus 1:11 and archaeology (e.g. Kitchen, On the Reliability of the Old Testament, 2003)."
    },
    {
      "id": "conquest",
      "name": "Conquest & Judges",
      "short": "Judges",
      "start": -1406, "end": -1050,
      "dates": "c. 1406–1050 BC",
      "color": "#8C9A3B",
      "summary": "Joshua leads Israel into Canaan; a cycle of apostasy and deliverance under the judges; Ruth; Samuel.",
      "debate": "Follows the early exodus date. The judges' tenures overlap in places, so individual dates are approximate."
    },
    {
      "id": "united",
      "name": "United Monarchy",
      "short": "United Kingdom",
      "start": -1050, "end": -931,
      "dates": "c. 1050–931 BC",
      "color": "#3F8F6B",
      "summary": "Saul, David and Solomon reign over all twelve tribes; Jerusalem becomes the capital; the temple is built.",
      "debate": "Saul's reign length is uncertain in the Hebrew text of 1 Samuel 13:1; Acts 13:21 gives forty years."
    },
    {
      "id": "divided",
      "name": "Divided Kingdom",
      "short": "Divided Kingdom",
      "start": -931, "end": -586,
      "dates": "931–586 BC",
      "color": "#2F7FA6",
      "summary": "Israel in the north and Judah in the south; the prophets; Samaria falls to Assyria (722 BC), Jerusalem to Babylon (586 BC).",
      "debate": "Reign dates follow Thiele. Jerusalem's fall is dated 587 or 586 BC depending on how Judah's regnal year is reckoned."
    },
    {
      "id": "exile",
      "name": "Exile in Babylon",
      "short": "Exile",
      "start": -586, "end": -538,
      "dates": "586–538 BC",
      "color": "#5B5BA8",
      "summary": "Judah in captivity; Daniel and Ezekiel; Babylon falls to Cyrus of Persia (539 BC).",
      "debate": "Deportations began in 605 and 597 BC; the seventy years of Jeremiah 25:11 are counted from 605 or 586 BC."
    },
    {
      "id": "return",
      "name": "Return & Restoration",
      "short": "Return",
      "start": -538, "end": -430,
      "dates": "538–c. 430 BC",
      "color": "#8A5AA8",
      "summary": "The exiles return under Zerubbabel, Ezra and Nehemiah; the temple and walls are rebuilt; Esther; the last prophets.",
      "debate": "Most date Ezra's return to 458 BC (the 7th year of Artaxerxes I); a minority place it in 398 BC."
    },
    {
      "id": "intertestamental",
      "name": "Between the Testaments",
      "short": "Intertestamental",
      "start": -430, "end": -5,
      "dates": "c. 430–5 BC",
      "color": "#A8577A",
      "summary": "Persian, Greek and Roman rule; the Septuagint; the Maccabean revolt; Herod the Great.",
      "debate": "No canonical narrative covers these years; dates come from Greek and Roman historians and 1–2 Maccabees."
    },
    {
      "id": "christ",
      "name": "Life of Christ",
      "short": "Christ",
      "start": -5, "end": 30,
      "dates": "c. 5 BC – AD 30/33",
      "color": "#C23B4B",
      "summary": "The birth, ministry, death and resurrection of Jesus.",
      "debate": "Jesus was born before Herod's death (4 BC, Matthew 2:1). The crucifixion is dated AD 30 or AD 33; this timeline marks AD 30 and notes AD 33 (Hoehner)."
    },
    {
      "id": "church",
      "name": "The Early Church",
      "short": "Early Church",
      "start": 30, "end": 95,
      "dates": "AD 30/33 – c. 95",
      "color": "#C9862B",
      "summary": "Pentecost, the spread of the gospel from Jerusalem to Rome, Paul's journeys and letters, Revelation.",
      "debate": "Revelation is usually dated c. AD 95 under Domitian (Irenaeus); some date it before AD 70."
    }
  ],
