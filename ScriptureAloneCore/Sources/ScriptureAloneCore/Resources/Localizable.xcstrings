    "Following God’s ways from the heart." : {
      "comment" : "Life theme description: one line under “Obedience” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gottes Wege von Herzen gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir los caminos de Dios de corazón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre les voies de Dieu de tout son cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguire le vie di Dio con tutto il cuore."
