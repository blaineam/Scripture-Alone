          "stringUnit" : {
            "state" : "translated",
            "value" : "Confidare nel provvedere di Dio nelle difficoltà economiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経済的に苦しいときも、神の備えに信頼します。"
