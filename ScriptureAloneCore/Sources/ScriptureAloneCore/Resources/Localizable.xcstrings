          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "借着服事他人来跟随耶稣。"
          }
        }
      }
    },
    "For when your mind won’t stop racing and tomorrow feels heavy." : {
      "comment" : "Life theme description: one line under “Anxiety & Worry” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Zeiten, in denen die Gedanken nicht zur Ruhe kommen und das Morgen schwer wiegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cuando la mente no deja de dar vueltas y el mañana pesa demasiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vos pensées s’emballent et que demain vous pèse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quando la mente non si ferma e il domani pesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思いが駆けめぐって止まらず、明日のことが重く感じられるときの励ましです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각이 멈추지 않고 내일이 무겁게 느껴질 때 붙잡을 말씀입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para quando a mente não para e o amanhã pesa demais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当思绪停不下来、明天让你感到沉重时。"
          }
        }
      }
    },
