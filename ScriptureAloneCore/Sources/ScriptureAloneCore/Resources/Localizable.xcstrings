    "Giving God the honor He is due." : {
      "comment" : "Life theme description: one line under “Worship & Praise” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gott die Ehre geben, die ihm gebührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar a Dios la honra que merece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendre à Dieu l’honneur qui lui est dû."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare a Dio l’onore che Gli è dovuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "神にふさわしい栄光をおささげします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나님께 합당한 영광을 돌려 드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar a Deus a honra que Lhe é devida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将神当得的荣耀归给他。"
          }
        }
      }
    },
    "Giving freely, as God has given." : {
      "comment" : "Life theme description: one line under “Generosity” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frei geben, wie Gott gegeben hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar con libertad, como Dios nos ha dado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donner librement, comme Dieu a donné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare con liberalità, come Dio ha dato a noi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "神が与えてくださったように、私たちも喜んで与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나님께서 주신 것처럼 우리도 기꺼이 나눕니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar com liberalidade, como Deus nos deu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白白地给，正如神白白地给了我们。"
          }
        }
      }
    },
    "Giving thanks in every circumstance." : {
      "comment" : "Life theme description: one line under “Gratitude” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dankbar sein in allen Dingen."
