    },
    "Trusting God with what hasn’t happened yet." : {
      "comment" : "Life theme description: one line under “Fear of the Future” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gott anvertrauen, was noch nicht geschehen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar a Dios lo que todavía no ha sucedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confier à Dieu ce qui n’est pas encore arrivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affidare a Dio ciò che non è ancora accaduto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ起きていないことを、神にゆだねることを学びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 일어나지 않은 일을 하나님께 맡기는 법을 배웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar a Deus aquilo que ainda não aconteceu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把尚未发生的事交托给神。"
          }
        }
      }
    },
    "Trusting God’s provision under financial strain." : {
      "comment" : "Life theme description: one line under “Money Worries” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gottes Versorgung vertrauen, wenn das Geld knapp ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar en la provisión de Dios en tiempos de apuro económico."
          }
        },
        "fr" : {
          "stringUnit" : {
