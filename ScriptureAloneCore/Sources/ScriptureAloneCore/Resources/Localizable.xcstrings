          "stringUnit" : {
            "state" : "translated",
            "value" : "从心里遵行神的道。"
          }
        }
      }
    },
    "Following Jesus by serving others." : {
      "comment" : "Life theme description: one line under “Serving” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesus nachfolgen, indem man anderen dient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir a Jesús sirviendo a los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre Jésus en servant les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguire Gesù servendo gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人に仕えることで、イエスに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람을 섬기며 예수님을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
