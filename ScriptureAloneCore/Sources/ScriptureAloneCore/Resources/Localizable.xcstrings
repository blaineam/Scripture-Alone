          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’échappe à sa main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla è fuori dalla Sua mano."
          }
