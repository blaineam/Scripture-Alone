    "How God meets you in hard things, and what He does through them." : {
      "comment" : "Life theme description: one line under “Suffering & Trials” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Gott dir im Schweren begegnet und was er dadurch wirkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo Dios te sale al encuentro en lo difícil, y lo que hace a través de ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment Dieu vous rejoint dans ce qui est dur, et ce qu’il accomplit à travers cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come Dio ti viene incontro nelle difficoltà, e ciò che opera attraverso di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦難の中で神がどのように出会い、何をしてくださるのかを知ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어려움 속에서 만나 주시고 그 고난을 통해 일하시는 하나님을 봅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como Deus vem ao seu encontro nas dificuldades e o que Ele faz por meio delas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "神如何在艰难中与你相遇，又借着艰难成就什么。"
          }
        }
      }
    },
    "How wide and long and high and deep His love is." : {
      "comment" : "Life theme description: one line under “God’s Love” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
