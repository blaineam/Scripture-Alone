    "Enough in God, in plenty or in want." : {
      "comment" : "Life theme description: one line under “Contentment” in the Topics directory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genug in Gott – im Überfluss wie im Mangel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suficiente en Dios, en la abundancia o en la escasez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assez en Dieu, dans l’abondance comme dans le manque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sazi in Dio, nell’abbondanza come nel bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豊かなときも乏しいときも、神にあって満ち足りています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풍부할 때나 궁핍할 때나 하나님 안에서 넉넉합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deus basta, na fartura ou na escassez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论丰富或缺乏，有神就够了。"
          }
        }
      }
