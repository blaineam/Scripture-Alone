        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心から神の道に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음을 다해 하나님의 길을 따릅니다."
