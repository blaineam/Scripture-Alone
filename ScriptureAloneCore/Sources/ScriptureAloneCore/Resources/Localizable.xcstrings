    "%@ This app cannot open protected files." : {
      "comment" : "Error. %@ is a sentence saying how the file is protected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Diese App kann geschützte Dateien nicht öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esta app no puede abrir archivos protegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cette app ne peut pas ouvrir les fichiers protégés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Questa app non può aprire file protetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ このアプリでは保護されたファイルを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 앱은 보호된 파일을 열 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Este app não pode abrir arquivos protegidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@本应用无法打开受保护的文件。"
          }
        }
      }
    },
    "%@ could not be read: %@" : {
