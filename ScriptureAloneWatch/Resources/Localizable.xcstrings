    "%@ on your iPhone can't be read here. Online translations can't be stored on the watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf deinem iPhone kann hier nicht gelesen werden. Online-Übersetzungen lassen sich nicht auf der Watch speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de tu iPhone no se puede leer aquí. Las traducciones en línea no se pueden guardar en el reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire %@ de votre iPhone ici. Les traductions en ligne ne peuvent pas être stockées sur la montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sul tuo iPhone non è leggibile qui. Le traduzioni online non possono essere salvate sull'orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の%@はここでは読めません。オンラインの翻訳は Watch に保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 %@은(는) 여기서 읽을 수 없습니다. 온라인 번역본은 시계에 저장할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler %@ do seu iPhone aqui. Traduções on-line não podem ser armazenadas no relógio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 %@ 无法在此读取。在线译本无法存储在手表上。"
          }
        }
      }
    },
