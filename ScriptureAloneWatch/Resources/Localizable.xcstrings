    "Life in the Spirit. Verse 1 is the hinge — everything after it flows from “no condemnation.”" : {
      "comment" : "Sample note shown in App Store screenshots (demo mode)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leben im Geist. Vers 1 ist der Dreh- und Angelpunkt – alles Weitere folgt aus „keine Verdammnis“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vida en el Espíritu. El versículo 1 es la clave: todo lo demás nace de “ninguna condenación”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vie dans l'Esprit. Le verset 1 est la charnière — tout ce qui suit découle de « aucune condamnation »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vita nello Spirito. Il versetto 1 è il perno: tutto ciò che segue scaturisce da «nessuna condanna»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "御霊による命。1 節が要で、「罪に定められることはない」からすべてが流れ出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성령 안에서의 삶. 1절이 핵심입니다. 그 뒤의 모든 것이 “정죄함이 없나니”에서 흘러나옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vida no Espírito. O versículo 1 é o eixo — tudo depois dele flui de “nenhuma condenação”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在圣灵里的生命。第 1 节是关键转折——之后的一切都源于「不定罪」。"
          }
        }
      }
    },
