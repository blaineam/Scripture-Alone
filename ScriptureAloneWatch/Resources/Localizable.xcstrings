    "Follows your iPhone. A translation you import there appears here too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt deinem iPhone. Eine dort importierte Übersetzung erscheint auch hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue a tu iPhone. Las traducciones que importes allí aparecen aquí también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit votre iPhone. Une traduction importée là-bas apparaît ici aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue il tuo iPhone. Una traduzione importata lì appare anche qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone と連動します。そこで読み込んだ翻訳はここにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 따릅니다. 거기서 가져온 번역본이 여기에도 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue o seu iPhone. Uma tradução importada lá também aparece aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 iPhone 同步。在那里导入的译本也会出现在这里。"
          }
        }
      }
    },
    "Highlight verses on your iPhone, iPad or Mac. They sync through iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Verse auf deinem iPhone, iPad oder Mac. Sie werden über iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resalta versículos en tu iPhone, iPad o Mac. Se sincronizan por iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surlignez des versets sur votre iPhone, iPad ou Mac. Ils se synchronisent via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evidenzia i versetti su iPhone, iPad o Mac. Si sincronizzano tramite iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone、iPad、Macで節をハイライトすると、iCloudで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad 또는 Mac에서 구절을 하이라이트하세요. iCloud로 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque versículos no iPhone, iPad ou Mac. Eles sincronizam pelo iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone、iPad 或 Mac 上高亮经节，它们会通过 iCloud 同步。"
