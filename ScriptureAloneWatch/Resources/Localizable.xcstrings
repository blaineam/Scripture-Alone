    "Evening sermon: Born of the Spirit" : {
      "comment" : "Sample note shown in App Store screenshots (demo mode)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abendpredigt: Aus dem Geist geboren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sermón de la tarde: Nacidos del Espíritu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sermon du soir : Naître de l'Esprit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sermone serale: nati dallo Spirito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕拝の説教：霊から生まれる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁 설교: 성령으로 난 자"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sermão da noite: Nascido do Espírito"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚堂讲道：从圣灵而生"
          }
        }
      }
    },
    "Favorite a verse here or on your iPhone, iPad or Mac. It syncs through iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere einen Vers hier oder auf deinem iPhone, iPad oder Mac als Favorit. Die Synchronisierung läuft über iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca un versículo como favorito aquí o en tu iPhone, iPad o Mac. Se sincroniza por iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un verset aux favoris ici ou sur votre iPhone, iPad ou Mac. La synchronisation se fait via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un versetto ai preferiti qui o su iPhone, iPad o Mac. Si sincronizza con iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここか iPhone、iPad、Mac で聖句をお気に入りに追加。iCloud で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 또는 iPhone, iPad, Mac에서 구절을 즐겨찾기하세요. iCloud로 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque um versículo como favorito aqui ou no seu iPhone, iPad ou Mac. Ele é sincronizado pelo iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此处或在 iPhone、iPad、Mac 上收藏经文，通过 iCloud 同步。"
          }
        }
      }
    },
