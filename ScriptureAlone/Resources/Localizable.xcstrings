          }
        }
      }
    },
    "Gets today’s verse — the same one the Verse of the Day widget shows." : {
      "comment" : "App Intent description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft den heutigen Vers ab – denselben, den das Vers-des-Tages-Widget zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
