    "Shared with You" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir geteilt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartido contigo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagé avec vous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivisi con te"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたと共有"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나와 공유됨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhado com você"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与你共享"
          }
        }
      }
    },
    "Shared with you live and read-only: their highlights and notes appear in the text as they add them, kept apart from your own. You’ll find it again under Appearance → Keepsake & Export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live und nur zum Lesen mit dir geteilt: Markierungen und Notizen der anderen Person erscheinen im Text, sobald sie hinzugefügt werden – getrennt von deinen eigenen. Du findest das wieder unter „Darstellung“ → „Erinnerung & Export“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartido contigo en directo y solo lectura: sus subrayados y notas aparecen en el texto a medida que los añade, separados de los tuyos. Lo encontrarás de nuevo en Aspecto → Recuerdo y exportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagé avec vous en direct et en lecture seule : ses surlignages et ses notes apparaissent dans le texte à mesure qu'ils sont ajoutés, distincts des vôtres. Vous le retrouverez sous Apparence → Souvenir et exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivisa con te dal vivo e in sola lettura: le loro evidenziazioni e note compaiono nel testo man mano che le aggiungono, separate dalle tue. La ritrovi in Aspetto → Ricordo ed esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ共有・読み取り専用であなたと共有されています。相手のハイライトとメモは、追加されると本文に表示され、あなた自身のものとは区別されます。「外観」→「思い出と書き出し」からいつでも開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 읽기 전용으로 나와 공유되었습니다. 상대방이 추가하는 하이라이트와 메모가 본문에 바로 표시되며, 내 것과는 구분되어 보관됩니다. 다시 보려면 외관 → 기념 성경 및 내보내기로 이동하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhado com você ao vivo e somente leitura: os destaques e as notas dessa pessoa aparecem no texto conforme ela os adiciona, separados dos seus. Você encontra tudo de novo em Aparência → Recordação e exportação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以实时只读方式与你共享：对方添加的高亮和笔记会随时显示在经文中，并与你自己的分开存放。你可在“外观”→“珍藏与导出”中再次找到它。"
          }
        }
      }
    },
