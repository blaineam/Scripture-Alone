    "iCloud didn’t allow this. Check that you’re signed in to the Apple Account the invitation was sent to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat das nicht zugelassen. Prüfe, ob du mit dem Apple-Account angemeldet bist, an den die Einladung gesendet wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no lo ha permitido. Comprueba que has iniciado sesión con la cuenta de Apple a la que se envió la invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud a refusé. Vérifiez que vous êtes connecté au compte Apple auquel l’invitation a été envoyée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud non l’ha consentito. Verifica di aver eseguito l’accesso all’account Apple a cui è stato inviato l’invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud がこれを許可しませんでした。招待の送信先の Apple アカウントでサインインしているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에서 허용하지 않았습니다. 초대를 받은 Apple 계정으로 로그인했는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud não permitiu isso. Verifique se você entrou na Conta Apple para a qual o convite foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 未允许此操作。请确认你已登录收到邀请的 Apple 账户。"
          }
        }
      }
    },
    "iCloud needs to confirm this invitation. Open the link again from Messages or Mail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud muss diese Einladung bestätigen. Öffne den Link erneut in Nachrichten oder Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud necesita confirmar esta invitación. Vuelve a abrir el enlace desde Mensajes o Mail."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud doit confirmer cette invitation. Rouvrez le lien depuis Messages ou Mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud deve confermare questo invito. Apri di nuovo il link da Messaggi o Mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud がこの招待を確認する必要があります。メッセージまたはメールからリンクをもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에서 이 초대를 확인해야 합니다. 메시지 또는 메일에서 링크를 다시 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud precisa confirmar este convite. Abra o link novamente no Mensagens ou no Mail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 需要确认此邀请。请从「信息」或「邮件」中重新打开该链接。"
          }
        }
      }
    },
