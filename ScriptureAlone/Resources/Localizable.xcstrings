    "Adds a note, attached to a passage if you name one. It syncs to your other devices like any note." : {
      "comment" : "App Intent description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Notiz hinzu, verknüpft mit einer Bibelstelle, wenn du eine angibst. Sie wird wie jede Notiz auf deine anderen Geräte synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una nota, vinculada a un pasaje si indicas uno. Se sincroniza con tus otros dispositivos como cualquier nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une note, liée à un passage si vous en indiquez un. Elle se synchronise avec vos autres appareils comme toute note."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una nota, collegata a un passo se ne indichi uno. Si sincronizza sugli altri dispositivi come ogni nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを追加します。聖句を指定するとその箇所に紐付きます。ほかのメモと同じように、ほかのデバイスにも同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 추가하고, 구절을 지정하면 해당 구절에 연결합니다. 다른 메모처럼 다른 기기에도 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma nota, anexada a uma passagem se você indicar uma. Ela é sincronizada com seus outros dispositivos como qualquer nota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
