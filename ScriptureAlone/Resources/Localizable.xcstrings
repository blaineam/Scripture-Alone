    "%@ doesn’t allow its text to be exported. Switch to another translation to export your notes with the verses they’re about." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erlaubt keinen Export des Bibeltextes. Wechsle zu einer anderen Übersetzung, um deine Notizen samt der zugehörigen Verse zu exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no permite exportar su texto. Cambia a otra traducción para exportar tus notas junto con los versículos correspondientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’autorise pas l’exportation de son texte. Choisissez une autre traduction pour exporter vos notes avec les versets concernés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La %@ non consente l'esportazione del testo. Passa a un'altra traduzione per esportare le note con i versetti a cui si riferiscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は本文の書き出しを許可していません。メモと対象の聖句を一緒に書き出すには、別の訳に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 본문 내보내기를 허용하지 않습니다. 메모를 해당 구절과 함께 내보내려면 다른 번역본으로 전환하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ não permite exportar seu texto. Mude para outra tradução para exportar suas notas com os versículos correspondentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不允许导出其经文。若要在导出笔记时附上相应经文，请改用其他译本。"
          }
        }
      }
    },
