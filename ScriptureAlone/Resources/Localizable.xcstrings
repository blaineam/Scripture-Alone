    "Invitations are read-only and private. Removing someone stops their updates; they keep the copy they have." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einladungen sind schreibgeschützt und privat. Wenn du jemanden entfernst, erhält diese Person keine Updates mehr; die vorhandene Kopie bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las invitaciones son privadas y de solo lectura. Si quitas a alguien, deja de recibir actualizaciones; conserva la copia que tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les invitations sont privées et en lecture seule. Retirer quelqu’un arrête ses mises à jour ; il garde la copie qu’il a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inviti sono privati e di sola lettura. Rimuovendo una persona, non riceverà più aggiornamenti, ma conserva la copia che ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待は読み取り専用かつ非公開です。削除すると更新は届かなくなりますが、手元のコピーは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대는 읽기 전용이며 비공개입니다. 삭제하면 업데이트가 중단되지만, 이미 받은 사본은 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os convites são somente leitura e privados. Remover alguém interrompe as atualizações dessa pessoa; a cópia que ela tem permanece."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请为只读且私密。移除某人后其将不再收到更新，但已有的副本会保留。"
          }
        }
      }
    },
