    "Complete Bibles translated from the Hebrew and Greek. Reading in another language? Download a Bible from eBible.org and use Import a File." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständige Bibeln, aus dem Hebräischen und Griechischen übersetzt. Du liest in einer anderen Sprache? Lade eine Bibel von eBible.org und nutze „Datei importieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblias completas traducidas del hebreo y el griego. ¿Lees en otro idioma? Descarga una Biblia de eBible.org y usa Importar un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibles complètes traduites depuis l’hébreu et le grec. Vous lisez dans une autre langue ? Téléchargez une Bible sur eBible.org et utilisez Importer un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibbie complete tradotte dall’ebraico e dal greco. Leggi in un’altra lingua? Scarica una Bibbia da eBible.org e usa Importa un file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘブライ語・ギリシャ語から訳された聖書全巻。他の言語で読みますか？eBible.org から聖書をダウンロードし、「ファイルを読み込む」をご利用ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "히브리어와 그리스어에서 번역한 완역 성경입니다. 다른 언어로 읽으시나요? eBible.org에서 성경을 다운로드한 후 파일 가져오기를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bíblias completas traduzidas do hebraico e do grego. Lendo em outro idioma? Baixe uma Bíblia do eBible.org e use Importar um arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
