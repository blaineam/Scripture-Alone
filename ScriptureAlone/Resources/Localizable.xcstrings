          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この思い出の聖書はこのデバイスから削除されます。後でまた使うには元のファイルが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기념 성경이 이 기기에서 삭제됩니다. 나중에 다시 쓰려면 원본 파일이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
