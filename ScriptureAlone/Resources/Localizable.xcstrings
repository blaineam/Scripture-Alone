    "Which passage?" : {
      "comment" : "Siri asks for a Bible reference",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Stelle?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasaje?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
