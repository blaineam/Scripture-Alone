    "This last copy will be removed from this device. Keep it as a keepsake first if you’d like to hold on to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese letzte Kopie wird von diesem Gerät entfernt. Sichere sie vorher als Erinnerung, wenn du sie behalten möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta última copia se eliminará de este dispositivo. Guárdala antes como recuerdo si quieres conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette dernière copie sera supprimée de cet appareil. Conservez-la d’abord comme souvenir si vous souhaitez la garder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ultima copia verrà rimossa da questo dispositivo. Se vuoi conservarla, salvala prima come ricordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後の1部がこの端末から削除されます。残しておきたい場合は、先に思い出として保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 마지막 사본이 기기에서 삭제됩니다. 계속 간직하려면 먼저 기념본으로 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta última cópia será removida deste dispositivo. Guarde-a antes como recordação, se quiser mantê-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后一份副本将从本设备移除。如想保留，请先存为珍藏。"
          }
        }
      }
    },
    "This passage is too long for a link — share the image or the text instead." : {
