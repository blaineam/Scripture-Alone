    "Gets the text of a passage from a translation on this device." : {
      "comment" : "App Intent description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft den Text einer Stelle aus einer Übersetzung auf diesem Gerät ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene el texto de un pasaje de una traducción de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtient le texte d’un passage depuis une traduction présente sur cet appareil."
          }
        },
        "it" : {
