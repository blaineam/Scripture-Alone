        }
      }
    },
    "The link carries the verse itself, so the card rebuilds in any browser. No server stores it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link trägt den Vers selbst, sodass die Karte in jedem Browser neu entsteht. Kein Server speichert sie."
