        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里没有来自 %@ 的内容"
          }
        }
      }
    },
    "Nothing has been added yet. Importing twice is safe — anything already here is left alone rather than duplicated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts hinzugefügt. Zweimal importieren ist unbedenklich – was schon da ist, bleibt unverändert und wird nicht doppelt angelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no se ha añadido nada. Importar dos veces es seguro: lo que ya está aquí se conserva en lugar de duplicarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a encore été ajouté. Importer deux fois ne pose aucun problème : ce qui est déjà là est conservé tel quel, sans doublon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato ancora aggiunto nulla. Importare due volte è sicuro: ciò che è già presente resta com’è, senza duplicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も追加されていません。二重にインポートしても安全です。既にあるものは重複せずそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 추가된 항목이 없습니다. 두 번 가져와도 안전합니다. 이미 있는 항목은 중복되지 않고 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi adicionado ainda. Importar duas vezes é seguro — o que já está aqui é mantido, não duplicado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未添加任何内容。重复导入是安全的——已有内容会保持不变，不会重复添加。"
          }
        }
      }
    },
