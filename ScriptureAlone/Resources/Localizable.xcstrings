    "Studio voices come from Mi Speaks, which isn’t installed." : {
      "comment" : "“Mi Speaks” is an app name; do not translate it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio-Stimmen stammen von Mi Speaks, das nicht installiert ist."
          }
