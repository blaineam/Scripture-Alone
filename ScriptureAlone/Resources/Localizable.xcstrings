    "Opens Go To with words to search for in the translation you’re reading." : {
      "comment" : "App Intent description. “Go To” is the name of the app's search screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet „Gehe zu“ mit Wörtern, nach denen in deiner aktuellen Übersetzung gesucht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ir a con palabras para buscar en la traducción que estás leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Aller à avec des mots à chercher dans la traduction que vous lisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre Vai a con le parole da cercare nella traduzione che stai leggendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読んでいる訳の中で検索する語句を指定して「ジャンプ」を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽고 있는 역본에서 검색할 단어와 함께 '이동'을 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ir para com palavras a buscar na tradução que você está lendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你正在阅读的译本中打开“前往”并搜索词语。"
          }
        }
      }
    },
    "Opens Scripture Alone to a new note on a passage, or on the chapter you’re reading." : {
      "comment" : "App Intent description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Scripture Alone mit einer neuen Notiz zu einer Stelle oder zum aktuellen Kapitel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Scripture Alone en una nota nueva sobre un pasaje o sobre el capítulo que estás leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Scripture Alone sur une nouvelle note portant sur un passage ou sur le chapitre que vous lisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre Scripture Alone su una nuova nota a un brano o al capitolo che stai leggendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripture Alone を開き、指定した箇所または読んでいる章の新規メモを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripture Alone을 열어 지정한 본문 또는 읽고 있는 장에 새 메모를 작성합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Scripture Alone em uma nova nota sobre uma passagem ou sobre o capítulo que você está lendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Scripture Alone 中为某段经文或你正在阅读的章节新建笔记。"
          }
        }
      }
    },
    "Opens Scripture Alone to a passage — a reference like John 3:16, in any language the app reads, or OSIS like John.3.16." : {
      "comment" : "App Intent description. “OSIS” and “John.3.16” stay as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Scripture Alone bei einer Stelle – eine Angabe wie Johannes 3,16 in jeder Sprache, die die App liest, oder OSIS wie John.3.16."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Scripture Alone en un pasaje: una referencia como Juan 3:16, en cualquier idioma que lea la app, u OSIS como John.3.16."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Scripture Alone sur un passage — une référence comme Jean 3:16, dans toute langue que l’app lit, ou OSIS comme John.3.16."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre Scripture Alone su un brano: un riferimento come Giovanni 3:16, in qualsiasi lingua letta dall’app, o in formato OSIS come John.3.16."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripture Alone を開いて指定の箇所を表示します。ヨハネ 3:16 のような参照（アプリが読めるどの言語でも）や、John.3.16 のような OSIS 形式が使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripture Alone을 열어 본문을 표시합니다. 앱이 읽는 모든 언어의 요한복음 3:16 같은 성경 구절이나 John.3.16 같은 OSIS 형식을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Scripture Alone em uma passagem — uma referência como João 3:16, em qualquer idioma que o app leia, ou OSIS como John.3.16."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Scripture Alone 中打开经文——可使用应用支持的任意语言的经文出处（如约翰福音 3:16），或 OSIS 格式（如 John.3.16）。"
          }
        }
      }
    },
