    "Nothing else was on the slide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst war nichts auf der Folie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había nada más en la diapositiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y avait rien d’autre sur la diapositive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’era altro nella diapositiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライドには他に何もありませんでした。"
          }
        },
