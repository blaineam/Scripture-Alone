        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las voces de estudio proceden de Mi Speaks, que no está instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voix studio proviennent de Mi Speaks, qui n'est pas installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
