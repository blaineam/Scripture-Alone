    "Favorite a verse here or on your iPhone, iPad or Mac. It syncs through iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorisiere einen Vers hier oder auf iPhone, iPad oder Mac. Er wird über iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca un versículo como favorito aquí o en el iPhone, iPad o Mac. Se sincroniza con iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un verset aux favoris ici ou sur votre iPhone, iPad ou Mac. La synchronisation passe par iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un versetto ai preferiti qui o su iPhone, iPad o Mac. Si sincronizza con iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここか iPhone、iPad、Mac でお気に入りに追加できます。iCloud で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 또는 iPhone, iPad, Mac에서 구절을 즐겨찾기하세요. iCloud로 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorite um versículo aqui ou no seu iPhone, iPad ou Mac. Ele é sincronizado via iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在此处或 iPhone、iPad、Mac 上收藏经文，通过 iCloud 同步。"
          }
        }
      }
    },
    "Favorite a verse in Scripture Alone — tap verses, then the heart — and it will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere einen Vers in Scripture Alone als Favorit – tippe auf Verse, dann auf das Herz – und er erscheint hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca un versículo como favorito en Scripture Alone (toca los versículos y luego el corazón) y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez un verset en favori dans Scripture Alone — touchez des versets, puis le cœur — et il apparaîtra ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un versetto ai preferiti in Scripture Alone — tocca i versetti, poi il cuore — e comparirà qui."
