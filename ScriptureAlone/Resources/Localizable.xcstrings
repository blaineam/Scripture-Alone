    "Each note’s passages are quoted above what was written. Very long passages are shortened to their opening verses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stellen jeder Notiz werden über dem Geschriebenen zitiert. Sehr lange Stellen werden auf ihre ersten Verse gekürzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasajes de cada nota se citan encima de lo escrito. Los pasajes muy largos se acortan a sus primeros versículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les passages de chaque note sont cités au-dessus du texte écrit. Les passages très longs sont réduits à leurs premiers versets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani di ogni nota sono citati sopra il testo scritto. I brani molto lunghi sono abbreviati ai versetti iniziali."
          }
