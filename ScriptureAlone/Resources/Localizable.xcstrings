    "The American Bible Society's free Starter plan is for non-commercial use and lets you pick three copyrighted translations. The key is yours." : {
      "comment" : "Explains a provider of licensed Bible text. “Starter” is the name of API.Bible's free plan.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Starter-Tarif der American Bible Society ist für die nicht-kommerzielle Nutzung und lässt dich drei urheberrechtlich geschützte Übersetzungen wählen. Der Schlüssel gehört dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan Starter gratuito de la American Bible Society es para uso no comercial y permite elegir tres traducciones con copyright. La clave es tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forfait Starter gratuit de l’American Bible Society est réservé à un usage non commercial et permet de choisir trois traductions sous droits d’auteur. La clé vous appartient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano Starter gratuito dell'American Bible Society è per uso non commerciale e permette di scegliere tre traduzioni protette da copyright. La chiave è tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "American Bible Society の無料 Starter プランは非商用向けで、著作権のある訳を3つ選べます。キーはあなたのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미국성서공회의 무료 Starter 플랜은 비상업적 용도이며, 저작권이 있는 번역본 3종을 고를 수 있습니다. 키는 회원님의 것입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano Starter gratuito da American Bible Society é para uso não comercial e permite escolher três traduções protegidas por direitos autorais. A chave é sua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美国圣经公会的免费 Starter 方案供非商业用途，可选择三个有版权的译本。密钥归你所有。"
          }
        }
      }
    },
    "The American Standard Version couldn’t be opened. %@" : {
      "comment" : "%@ is a sentence giving the reason.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
