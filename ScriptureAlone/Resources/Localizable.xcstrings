    "Scroll to Advanced and tap “Export your data”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle zu „Erweitert“ und tippe auf „Deine Daten exportieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja hasta Avanzado y toca «Exporta tus datos»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler jusqu’à Avancé et touchez « Exporter vos données »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri fino ad Avanzate e tocca “Esporta i tuoi dati”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「詳細」までスクロールして「データを書き出す」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고급으로 스크롤한 다음 \"데이터 내보내기\"를 탭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role até Avançado e toque em “Exportar seus dados”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动到“高级”，然后轻点“导出你的数据”。"
          }
        }
      }
    },
    "Scrolls the chapter hands-free. Hold for speed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt das Kapitel freihändig. Zum Beschleunigen gedrückt halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza el capítulo solo. Mantén pulsado para la velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait défiler le chapitre en mains libres. Maintenez pour la vitesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorre il capitolo a mani libere. Tieni premuto per la velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "章を自動スクロールします。長押しで速度調整。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장을 자동으로 스크롤합니다. 길게 눌러 속도 조절."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rola o capítulo sozinho. Mantenha pressionado para a velocidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动滚动本章，无需手动。按住可调速。"
          }
        }
      }
    },
