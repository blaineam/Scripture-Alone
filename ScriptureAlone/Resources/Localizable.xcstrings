            "value" : "Etwa %lld MB, einmal geladen und zum Offline-Lesen gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %lld MB, que se descargan una vez y se conservan para leer sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %lld Mo, téléchargés une fois et conservés pour la lecture hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %lld MB, scaricati una volta e conservati per leggere offline."
