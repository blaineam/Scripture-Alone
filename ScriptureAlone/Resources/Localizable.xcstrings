    "Add your free API.Bible key in Manage Translations to read this translation." : {
      "comment" : "“Manage Translations” is the name of a screen in the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen kostenlosen API.Bible-Schlüssel unter „Übersetzungen verwalten“ hinzu, um diese Übersetzung zu lesen."
