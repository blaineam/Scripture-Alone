        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas coordenadas de locais nos dados do OpenBible vêm do OpenStreetMap. © colaboradores do OpenStreetMap, disponíveis sob a Open Database License."
