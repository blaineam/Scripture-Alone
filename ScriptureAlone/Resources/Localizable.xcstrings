    "%@ allows up to %lld verses in one quotation. Select fewer to copy or share." : {
      "comment" : "%1$@ is a translation abbreviation, e.g. “ESV”; %2$lld is a number of verses.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erlaubt höchstens %2$lld Verse pro Zitat. Wähle weniger aus, um sie zu kopieren oder zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ allows up to %2$lld verses in one quotation. Select fewer to copy or share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ permite citar hasta %2$lld versículos a la vez. Selecciona menos para copiar o compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ autorise au maximum %2$lld versets par citation. Sélectionnez-en moins pour copier ou partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La %1$@ consente fino a %2$lld versetti per citazione. Selezionane meno per copiare o condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の引用は一度に %2$lld 節までです。選択を減らしてコピーまたは共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 한 번에 최대 %2$lld개 구절까지 인용할 수 있습니다. 더 적게 선택해 복사하거나 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ permite até %2$lld versículos por citação. Selecione menos para copiar ou compartilhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 每次引用最多 %2$lld 节经文。请减少选择后再复制或分享。"
          }
        }
      }
    },
    "%@ allows up to %lld%% of %@ in one quotation. Select fewer verses to copy or share." : {
      "comment" : "%1$@ is a translation abbreviation, e.g. “ESV”; %2$lld is a percentage; %3$@ is a book of the Bible.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erlaubt pro Zitat höchstens %2$lld %% von %3$@. Wähle weniger Verse aus, um zu kopieren oder zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ allows up to %2$lld%% of %3$@ in one quotation. Select fewer verses to copy or share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ permite citar hasta el %2$lld %% de %3$@ a la vez. Selecciona menos versículos para copiar o compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ autorise au maximum %2$lld %% de %3$@ par citation. Sélectionnez moins de versets pour copier ou partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La %1$@ consente fino al %2$lld%% di %3$@ per citazione. Seleziona meno versetti per copiare o condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の引用は一度に %3$@ の %2$lld%% までです。節の選択を減らしてコピーまたは共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 한 번에 %3$@의 최대 %2$lld%%까지 인용할 수 있습니다. 구절을 더 적게 선택해 복사하거나 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ permite até %2$lld%% de %3$@ por citação. Selecione menos versículos para copiar ou compartilhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 每次引用最多为%3$@的 %2$lld%%。请减少经文选择后再复制或分享。"
          }
        }
      }
    },
    "%@ can't be quoted a whole book at a time. Select less of %@ to copy or share." : {
      "comment" : "%1$@ is a translation abbreviation, e.g. “ESV”; %2$@ is a book of the Bible.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ darf nicht als ganzes Buch zitiert werden. Wähle weniger aus %2$@ aus, um zu kopieren oder zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't be quoted a whole book at a time. Select less of %2$@ to copy or share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no permite citar un libro completo. Selecciona menos de %2$@ para copiar o compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas être cité un livre entier à la fois. Sélectionnez moins de %2$@ pour copier ou partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La %1$@ non consente di citare un libro intero. Seleziona meno di %2$@ per copiare o condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は書全体を一度に引用できません。%2$@ の選択を減らしてコピーまたは共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 책 전체를 한 번에 인용할 수 없습니다. %2$@에서 더 적게 선택해 복사하거나 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ não permite citar um livro inteiro. Selecione menos de %2$@ para copiar ou compartilhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不允许一次引用整卷书。请减少%2$@的选择后再复制或分享。"
          }
        }
      }
    },
