    "Today’s passage on your watch face.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der heutige Abschnitt auf deinem Zifferblatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pasaje de hoy en tu esfera del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage du jour sur votre cadran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passo di oggi sul quadrante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の聖句を文字盤に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치 페이스에 표시되는 오늘의 구절."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A passagem de hoje no mostrador do relógio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表盘上查看今日经文。"
          }
        }
      }
    },
