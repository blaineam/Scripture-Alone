<?xml version="1.0" encoding="utf-8"?>
<!-- Source Serif 4 at the text weight, for widget text the launcher draws (a RemoteViews TextView
     takes a font resource, not a Compose FontFamily). It stands in for New York, as in the reader. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/source_serif_4"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400, 'opsz' 16" />
</font-family>
