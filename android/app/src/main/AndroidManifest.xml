<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Listen: reading aloud continues with the screen off, from a media-playback foreground service
         (Android 14 requires the typed permission), with its controls in a notification (Android 13+
         asks for that at the first Listen). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Camera notes: photographing a sermon slide (ui/camera/). Asked for at the first scan; the app
         works without a camera, where photos, files and paste still bring a slide in. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- From Android 11 an app must declare the speech engines it binds to, or TextToSpeech finds none. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ScriptureAloneApplication"
        android:allowBackup="true"
        android:backupAgent=".data.backup.SettingsBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The app's links (data/share/AppLink.kt, AppCommand.kt): scripturealone://open?ref=… (stored
                 keys, OSIS, urn:osis:, a typed reference in any of the app's languages), passage/<ref>,
                 search?q=…, note/<uuid>, notes, favorites, share links (…#s=…), and the shortcuts' today,
                 continue, new-note and feature?name=…. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scripturealone" />
            </intent-filter>
            <!-- App Links: a passage on the web page's own path, https://wemiller.com/apps/scripture-alone/
                 passage/<ref>. A path of its own, so the product page itself is never taken over. The
                 page's ?ref=, #ref= and #s= links are the WebLinks alias below (Android 15+). Verified
                 against https://wemiller.com/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="wemiller.com" />
                <data android:host="www.wemiller.com" />
                <data android:pathPrefix="/apps/scripture-alone/passage/" />
            </intent-filter>
            <!-- App shortcuts and Google Assistant App Actions. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Keepsake Bibles (ui/keepsake/): the type the iOS app declares for `.scripturelegacy`
                 files, `application/vnd.scripturealone.legacy+zip` (docs/heir-mode.md)… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.scripturealone.legacy+zip" />
            </intent-filter>
            <!-- …and, since most senders don't know that type, the file extension where the URI carries
                 the name (a file manager, a file:// path). Several patterns, because pathPattern stops at
                 the first dot. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.scripturelegacy" />
                <data android:pathPattern=".*\\..*\\.scripturelegacy" />
                <data android:pathPattern=".*\\..*\\..*\\.scripturelegacy" />
            </intent-filter>
        </activity>

        <!-- The web page's passage and share links — https://wemiller.com/apps/scripture-alone/?ref=John.3.16,
             …/#ref=…, …/#s=… — which differ from the product page only in their query or fragment. Only
             Android 15 can match those (uri-relative-filter-group); an older one would match the bare
             page and take it over, so the alias is enabled from API 35 only (values-v35/bools.xml).
             Before that, the page's "Open in Scripture Alone" button uses the custom scheme. -->
        <activity-alias
            android:name=".WebLinks"
            android:enabled="@bool/web_fragment_links"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter
                android:autoVerify="true"
                tools:targetApi="35">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="wemiller.com" />
                <data android:host="www.wemiller.com" />
                <uri-relative-filter-group>
                    <data android:pathPrefix="/apps/scripture-alone" />
                    <data android:queryPrefix="ref=" />
                </uri-relative-filter-group>
                <uri-relative-filter-group>
                    <data android:pathPrefix="/apps/scripture-alone" />
                    <data android:fragmentPrefix="ref=" />
                </uri-relative-filter-group>
                <uri-relative-filter-group>
                    <data android:pathPrefix="/apps/scripture-alone" />
                    <data android:fragmentPrefix="s=" />
                </uri-relative-filter-group>
            </intent-filter>
        </activity-alias>

        <!-- Listen's media session: lock-screen and notification controls, headset buttons. -->
        <service
            android:name=".ui.listen.ListenPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Home-screen widgets (ui/widget/): the iOS widget extension's two widgets. -->
        <receiver
            android:name=".ui.widget.VerseOfDayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_votd_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_verse_of_day" />
        </receiver>
        <receiver
            android:name=".ui.widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favorites_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites" />
        </receiver>
        <activity
            android:name=".ui.widget.FavoritesConfigureActivity"
            android:exported="true"
            android:label="@string/widget_favorites_configure">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Redraws the widgets at local midnight and each three-hour slot, and when the clock changes. -->
        <receiver
            android:name=".ui.widget.WidgetClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Hands the verse-image designer's PNG to the share sheet (ui/share/ShareExport.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shareimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
        <!-- Keeps the widgets' snapshot and the watch current from process start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.blainemiller.scripturealone.ui.widget.WidgetSyncInitializer"
                android:value="androidx.startup" />
        </provider>
        <!-- ML Kit's text recognition runs on the device, but its SDK also uploads diagnostics (device
             and app details, a per-install id) to firebaselogging.googleapis.com through Google's
             datatransport. There is no official switch, so the transport's three entry points are
             stripped from the merged manifest: nothing can start it, and no such data leaves the
             phone. Recognition itself never used the network. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>
