<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Switches the widgets' demo library (DemoLibrary.swift's content) on or off: an explicit
             `adb shell am broadcast` to this receiver with the boolean extra "on" (see WidgetSync.kt). -->
