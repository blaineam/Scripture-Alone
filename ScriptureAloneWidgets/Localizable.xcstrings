    "Favorite a verse in Scripture Alone — tap verses, then the heart — and it will appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorisiere einen Vers in Scripture Alone – tippe auf Verse, dann auf das Herz – und er erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un versículo a favoritos en Scripture Alone —toca los versículos y luego el corazón— y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un verset aux favoris dans Scripture Alone — touchez des versets, puis le cœur — et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un versetto ai preferiti in Scripture Alone — tocca i versetti, poi il cuore — e apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripture Alone で聖句をタップしてハートを選ぶと、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripture Alone에서 구절을 탭한 후 하트를 눌러 즐겨찾기에 추가하면 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite um versículo no Scripture Alone — toque nos versículos e depois no coração — e ele aparecerá aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Scripture Alone 中收藏经文——点按经文，再点心形——即可显示在这里。"
          }
        }
      }
    },
