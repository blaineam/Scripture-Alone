    "A beloved passage each day, in the translation you read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag eine beliebte Stelle – in deiner Übersetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pasaje entrañable cada día, en la traducción que lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour, un passage aimé, dans votre traduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passo amato ogni giorno, nella traduzione che leggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日親しまれる聖句を、お読みの訳で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 사랑받는 말씀을, 읽고 계신 번역본으로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma passagem querida por dia, na tradução que você lê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一段经典经文，用你正在读的译本。"
          }
        }
      }
    },
