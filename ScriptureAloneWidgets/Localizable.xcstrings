    "Favorite a verse": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers favorisieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un versículo a favoritos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un verset aux favoris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un versetto ai preferiti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聖句をお気に入りに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구절 즐겨찾기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite um versículo"
          }
