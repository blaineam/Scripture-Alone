    "Rotates through the verses you’ve favorited, highlighted or written notes on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt abwechselnd die Verse, die du favorisiert, markiert oder mit Notizen versehen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre los versículos que has marcado como favoritos, resaltado o anotado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait défiler les versets que vous avez mis en favoris, surlignés ou annotés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna i versetti che hai aggiunto ai preferiti, evidenziato o annotato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り・ハイライト・メモを付けた聖句を順に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기, 하이라이트하거나 노트를 작성한 구절을 번갈아 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre os versículos que você favoritou, destacou ou anotou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮流显示你收藏、高亮或写过笔记的经文。"
          }
        }
      }
    },
